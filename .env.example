# Entorno
NODE_ENV=dev
PORT=3000
# Lista separada por comas. Vacio = abierto en dev, cerrado en produccion
CORS_ORIGINS=
# Detras de un proxy inverso: "1" (un salto), "true" o una lista de IPs/subredes. Sin esto, el rate
# limit ve la IP del proxy y todos los clientes comparten el mismo cupo.
# TRUST_PROXY=1

# MongoDB
DATABASE_URI=mongodb://localhost:27017
DATABASE_NAME=opinara

# JWT de la plataforma (no tiene relacion con OAuth de Google)
JWT_SECRET_KEY=cambiar-por-un-secreto-largo
JWT_ACCESS_EXPIRES_IN_SECONDS=86400
JWT_REFRESH_SECRET_KEY=cambiar-por-otro-secreto-largo
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# Cifrado de tokens de Google en reposo (AES-256-GCM).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1

# Rate limiting global
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Rate limiting de los endpoints con credenciales (login/refresh/contraseñas, tambien el login del admin)
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10

# --- Google Business Profile ---
# Credenciales del OAuth client (tipo "Web application") del proyecto de Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la URI autorizada en Google Cloud
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# A donde se redirige al usuario al terminar el flujo (vacio = responde JSON, util en dev)
GOOGLE_OAUTH_SUCCESS_URL=
GOOGLE_OAUTH_ERROR_URL=
# Vida del `state` anti-CSRF, en segundos
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Rate limit del callback publico
GOOGLE_CALLBACK_THROTTLE_LIMIT=20
GOOGLE_CALLBACK_THROTTLE_TTL=60000
# Cliente HTTP hacia Google: timeout, reintentos ante 429/5xx y backoff base
GOOGLE_HTTP_TIMEOUT_MS=15000
GOOGLE_HTTP_MAX_RETRIES=3
GOOGLE_HTTP_BACKOFF_MS=300
# Margen para renovar el access token antes de que expire
GOOGLE_TOKEN_REFRESH_SKEW_SECONDS=120

# --- Sincronizacion de reseñas ---
# Cron incremental (formato de @nestjs/schedule, con segundos)
REVIEW_SYNC_CRON=0 */15 * * * *
# Reconciliacion completa diaria: detecta reseñas borradas en Google
REVIEW_SYNC_FULL_CRON=0 0 3 * * *
# Poner en false para desactivar los cron (util en desarrollo)
REVIEW_SYNC_ENABLED=true
# Margen hacia atras del corte incremental, en minutos
REVIEW_SYNC_OVERLAP_MINUTES=5
# Tope de paginas por location (50 reseñas por pagina)
REVIEW_SYNC_MAX_PAGES=100

# --- Campañas, QR y landing publica ---
# Base del frontend que muestra el formulario: la URL del QR es {base}/r/{businessSlug}/{campaignSlug}
PUBLIC_APP_BASE_URL=http://localhost:3000
# Rate limit del QR publico: escaneos por minuto por IP y campaña. Pasado el limite, quien escanea va
# a /r/{negocio}/{campaña}/espera, que reintenta sola.
PUBLIC_THROTTLE_LIMIT=60
PUBLIC_THROTTLE_TTL=60000

# Mails (recuperar contraseña, invitaciones). Sin clave, en desarrollo el mail se escribe en el log.
MAIL_RESEND_API_KEY=
MAIL_FROM=Opinara <no-responder@opinara.app>
# Opcional: cuanto duran los links (en segundos).
# PASSWORD_RESET_EXPIRES_IN_SECONDS=3600
# INVITATION_EXPIRES_IN_SECONDS=604800
# Cuanto dura la sesion del administrador (sin refresh).
# ADMIN_TOKEN_EXPIRES_IN_SECONDS=28800

# Respuestas sugeridas. El proveedor del modelo es un adaptador: groq (por defecto, tiene plan
# gratis) o anthropic (Claude). Sin la clave del proveedor elegido, la función no se ofrece y el
# resto anda igual.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Opcional: otro modelo, u otra URL compatible con OpenAI (por ejemplo Ollama: http://localhost:11434/v1).
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Cuanto razona gpt-oss: low | medium (por defecto) | high. Con low entiende peor reseñas ambiguas.
# GROQ_REASONING_EFFORT=medium
# Con LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Tope de sugerencias por minuto e IP (cada una gasta cuota del proveedor).
# REPLY_SUGGESTIONS_THROTTLE_LIMIT=30
